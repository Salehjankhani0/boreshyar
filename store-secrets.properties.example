# این فایل را با نام store-secrets.properties کپی کنید (در Git قرار نمی‌گیرد) و مقادیر واقعی را بنویسید.
# همهٔ مقادیر را می‌توان به‌جای فایل، با متغیر محیطی هم‌نام داد.

# آدرس HTTPS سایت اصلی (با / پایانی). بیلد Release با مقدار نمونه شکست می‌خورد.
SITE_URL=https://boreshglass.ir/web/

# --- مایکت ---
# «کلید رمز عمومی RSA» برنامه از پنل توسعه‌دهندگان مایکت (کلید خصوصی/توکن سرور نیست)
MYKET_PUBLIC_KEY=
MYKET_APP_ID=ir.boreshyar.glass
# شناسهٔ محصول‌های مایکت که برنامه اجازهٔ خریدشان را دارد (جداشده با ویرگول)
MYKET_SKUS=plan__6m,plan_12m,plan_lifetime

# --- بازار ---
# کلید رمز عمومی (RSA) برنامه از پنل کافه‌بازار
BAZAAR_PUBLIC_KEY=
BAZAAR_APP_ID=ir.boreshyar.glass
# شناسهٔ محصول‌های بازار (پس از ساخت در پنل بازار پر کنید)
BAZAAR_SKUS=
